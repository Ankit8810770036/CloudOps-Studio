# ==============================================================================
# CloudOps Studio - Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# NEVER commit your actual .env file or real secrets to source control.
# ==============================================================================

# Server Network & Host Binding
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# AWS Cloud Credentials (Required only for LIVE AWS MODE)
# Leave empty or unset when operating in SIMULATION MODE (Safe Sandbox)
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# CORS Security Allowlists (Comma-separated origins, no wildcards when using credentials)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting Configurations (Requests per minute per client IP)
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_MUTATING=60
