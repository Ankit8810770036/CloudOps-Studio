[Unit]
Description=DevOps Python FastAPI Backend Daemon
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/devops_backend
ExecStart=/opt/devops_backend/venv/bin/uvicorn app:app --host 127.0.0.1 --port {{ backend_port | default(8000) }}
Restart=always
RestartSec=3
Environment=PORT={{ backend_port | default(8000) }}

[Install]
WantedBy=multi-user.target

