server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;
    root {{ web_root }};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

    # Health check endpoint for Nagios and Load Balancers
    location /healthz {
        access_log off;
        return 200 '{"status":"UP","server":"nginx","managed_by":"ansible"}';
        add_header Content-Type application/json;
    }

    # Error handling
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /var/www/html;
    }
}
